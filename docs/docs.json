{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Arca",
  "logo": {
    "dark": "/horizontal-dark.png",
    "light": "/horizontal-light.png"
  },
  "favicon": "/logo-dark.png",
  "theme": "maple",
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "cursor",
      "add-mcp",
      "vscode"
    ]
  },
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1E3A8A"
  },
  "fonts": {
    "heading": {
      "family": "Lora"
    },
    "body": {
      "family": "Inter"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@arca.com"
      },
      {
        "label": "Example App",
        "href": "https://github.com/Vishal-770/arca/tree/main/demo-app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://arca7.vercel.app/dashboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Vishal-770/arca"
    }
  },
  "api": {
    "mdx": {
      "server": "https://api-arca.vercel.app"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "pricing",
              "resources"
            ]
          },
          {
            "group": "Server-Side Validation",
            "pages": [
              "server-side/validation"
            ]
          },
          {
            "group": "React SDK",
            "pages": [
              "sdk/introduction",
              "sdk/setup",
              {
                "group": "Components",
                "pages": [
                  "sdk/components/arca-provider",
                  "sdk/components/arca-pricing-table"
                ]
              },
              "sdk/hooks/use-arca",
              "sdk/hooks/use-arca-perks",
              "sdk/theming",
              "sdk/types",
              "sdk/example-app"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/overview",
              "architecture/smart-accounts",
              "architecture/session-keys",
              "architecture/erc-1271",
              "architecture/autopay"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/authentication",
              "api-reference/wallet",
              "api-reference/analytics"
            ]
          },
          {
            "group": "Autopay",
            "pages": [
              "api-reference/autopay"
            ]
          },
          {
            "group": "Modular Wallets",
            "pages": [
              "api-reference/modular-wallets"
            ]
          },
          {
            "group": "Plans",
            "pages": [
              "api-reference/list-plans",
              "api-reference/get-plan",
              "api-reference/plan-analytics"
            ]
          },
          {
            "group": "Subscribers",
            "pages": [
              "api-reference/subscribers"
            ]
          }
        ]
      }
    ]
  }
}
